{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "drey": {
      "projectType": "application",
      "schematics": {},
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "assets"
              },
              {
                "glob": "katex.min.css",
                "input": "node_modules/katex/dist",
                "output": "katex"
              },
              {
                "glob": "*.woff2",
                "input": "node_modules/katex/dist/fonts",
                "output": "katex/fonts"
              }
            ],
            "styles": [
              "src/styles.css",
              "src/app/settings/settings-ui.css"
            ],
            "allowedCommonJsDependencies": [
              "cytoscape-cose-bilkent",
              "cytoscape-fcose",
              "@braintree/sanitize-url",
              "dayjs",
              "dayjs/plugin/isoWeek.js",
              "dayjs/plugin/customParseFormat.js",
              "dayjs/plugin/advancedFormat.js",
              "dayjs/plugin/duration.js",
              "fastdom",
              "fastdom/extensions/fastdom-promised.js"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1.35MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kB",
                  "maximumError": "10kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "drey:build:production"
            },
            "development": {
              "buildTarget": "drey:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "include": [
              "src/**/*.spec.ts",
              "plugins/**/*.spec.ts"
            ]
          }
        }
      }
    },
    "mission-control": {
      "projectType": "application",
      "root": "apps/mission-control",
      "sourceRoot": "apps/mission-control/src",
      "prefix": "mc",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/mission-control/src/main.ts",
            "tsConfig": "apps/mission-control/tsconfig.app.json",
            "outputPath": "dist/mission-control",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/mission-control/public"
              }
            ],
            "styles": [
              "apps/mission-control/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "mission-control:build:production"
            },
            "development": {
              "buildTarget": "mission-control:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "include": [
              "apps/mission-control/src/**/*.spec.ts"
            ]
          }
        }
      }
    }
  }
}
