{
  "name": "drey",
  "version": "0.0.0",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint \"electron/**/*.ts\" \"shared/**/*.ts\" \"src/**/*.ts\"",
    "build:renderer": "ng build",
    "build:electron": "tsc -p electron/tsconfig.json",
    "licenses:generate": "node scripts/generate-licenses.mjs",
    "prebuild": "npm run licenses:generate",
    "build": "npm run build:renderer && npm run build:electron",
    "electron": "node scripts/run-electron.js",
    "e2e": "npm run build && playwright test",
    "e2e:run": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:report": "playwright show-report",
    "dev": "concurrently -k -n ng,electron \"npm run start\" \"npm run dev:electron\"",
    "dev:electron": "wait-on http://localhost:4200 && npm run build:electron && cross-env DREY_RENDERER_URL=http://localhost:4200 npm run electron",
    "postinstall": "node node_modules/electron/install.js"
  },
  "private": true,
  "license": "GPL-3.0-only",
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "codemirror": "^6.0.2",
    "dictionary-de": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "markdown-it": "^15.0.1",
    "nspell": "^2.1.5",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.1.7",
    "@angular/cli": "^22.1.7",
    "@angular/compiler-cli": "^22.1.0",
    "@playwright/test": "^1.63.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "jsdom": "^28.0.0",
    "license-checker-rseidelsohn": "^5.0.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.0.8",
    "wait-on": "^9.1.0"
  }
}
